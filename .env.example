###############################################################################
# Keverna — Environment Configuration
###############################################################################

APP_NAME=Keverna
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://keverna.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
APP_TIMEZONE=Africa/Lagos

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

###############################################################################
# Multi-Tenancy
###############################################################################
CENTRAL_DOMAIN=keverna.test
ADMIN_DOMAIN=admin.keverna.test
TENANT_DOMAIN_SUFFIX=.keverna.test

# 'wildcard' (default) — nginx wildcard vhost + wildcard TLS cert cover
# every {slug}.keverna.com; ProvisionTenantSubdomain stamps the row and
# stops. 'dokwe-attach' — legacy Traefik/per-domain path (requires Dokwe
# routing setup with per-subdomain DNS/CNAMEs).
SUBDOMAIN_PROVISIONING_MODE=wildcard

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database — MySQL 8 per PRD §5.1
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=keverna
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Sessions, Cache, Queue
###############################################################################
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Reverb WebSocket server (marketing "platform-pulse" live counter + toast).
# Generate fresh values for prod via `php artisan reverb:install` or by
# assigning random strings, then run `php artisan reverb:start` under
# supervisor. Front-of-app requires the VITE_* mirrors so Echo picks them up.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=bunny
# Spatie Media Library default disk — 'public' for dev (storage/app/public),
# 'bunny' in staging+prod (PRD §5.1).
MEDIA_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=keverna

###############################################################################
# Redis (queues + cache + sessions + Horizon)
###############################################################################
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

###############################################################################
# Mail — routed through Sendpipe (FregateLab) in all envs but local (PRD §7.1)
###############################################################################
# Local dev: keep MAIL_MAILER=log so we don't burn through Sendpipe quota.
# Staging + prod: MAIL_MAILER=sendpipe and fill the Sendpipe block below.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@keverna.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Custom-domain CNAME target — the well-known hostname operators point
# their custom domain at. Resolves to Dokwe's ingress. Whichever DNS
# provider owns keverna.com (Namecheap today) owns the record itself.
###############################################################################
CUSTOM_DOMAIN_CNAME_TARGET=cname.keverna.com

###############################################################################
# Paystack — operator subscriptions (Keverna account) + guest bookings (operator account)
###############################################################################
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL="${APP_URL}/paystack/callback"

###############################################################################
# Sendpipe (FregateLab) — relay for ALL outbound email + WhatsApp OTPs
# (PRD §7.1 / §6.1.1). See sendpipe.org/docs.
###############################################################################
SENDPIPE_API_URL=https://sendpipe.fregatelab.com/v1
SENDPIPE_API_KEY=
SENDPIPE_FROM="${MAIL_FROM_ADDRESS}"
# Meta requires a pre-approved template for OTP sends outside the 24h window.
SENDPIPE_WA_OTP_TEMPLATE=kev_otp
SENDPIPE_WA_OTP_LANGUAGE=en

###############################################################################
# Google Maps — landing page embed (PRD §6.4.1)
###############################################################################
GOOGLE_MAPS_API_KEY=

###############################################################################
# Domain Registrar (Phase 2 — stubbed for v1.0)
###############################################################################
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
WHOGOHOST_API_KEY=

###############################################################################
# Pricing & Billing — PRD §4.1
###############################################################################
SUBSCRIPTION_ANNUAL_NGN=300000
TRIAL_DAYS=14
PAYSTACK_FEE_PERCENT=1.5
PAYSTACK_FEE_FLAT_NGN=0
PAYSTACK_FEE_CAP_NGN=2000
KEVERNA_FEE_PERCENT=5.0
KEVERNA_FEE_CAP_NGN=10000000
STAYS_DEPOSIT_PERCENT=30
STAYS_FEE_PERCENT_DEFAULT=2.5
STAYS_FEE_PERCENT_HIGH_TIER=2.5
STAYS_FEE_TIER_THRESHOLD_NGN=100000
GRACE_PERIOD_DAYS=3
LOCK_TO_ARCHIVE_DAYS=30

###############################################################################
# Vite
###############################################################################
VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Dokwe Storage — S3-compatible object storage (https://dokwe.com/docs/storage)
###############################################################################
# Mint credentials from Dashboard → Storage → your space → Keys → Mint Key.
# The secret is shown ONCE at mint time. Set MEDIA_DISK=dokwe (above) to
# route Spatie media-library uploads here.
#
# ENDPOINT      = https://<space-slug>-s3.dokwe.com    (S3 API)
# PUBLIC_URL    = https://<space-slug>-file.dokwe.com  (CDN, public spaces)
# BUCKET        = your space slug (same value as the sub in the endpoint)
# REGION        = us-east-1 (ignored by MinIO but required for SigV4)
DOKWE_ACCESS_KEY=
DOKWE_SECRET_KEY=
DOKWE_BUCKET=
DOKWE_ENDPOINT=
DOKWE_PUBLIC_URL=
DOKWE_REGION=us-east-1

# Dokwe Errors — remote exception ingest. Every uncaught 500-class error
# in prod/staging POSTs to {DOKWE_API_URL}/ingest/errors/{PROJECT_ID}.
# Left blank = reporter no-ops (safe default; won't crash the app).
DOKWE_ERRORS_ENABLED=true
DOKWE_ERRORS_PROJECT_ID=
DOKWE_ERRORS_TOKEN=

# Install branding (config/brand.php). Name shows in the auth chrome, tab
# titles and "Powered by"; set BRAND_URL to make that a link.
BRAND_NAME=Centurion
BRAND_URL=

# App-level HTTP → HTTPS redirect. Set false if the proxy in front of the
# app doesn't forward `X-Forwarded-Proto: https` (symptom: 301 loop) and
# the edge already enforces HTTPS. With an https APP_URL, generated links
# stay https regardless. Pair with SESSION_SECURE_COOKIE=true in prod.
FORCE_HTTPS=true

# In-app domain management — OFF for solo installs. The hotel's domain is
# attached once in the Dokwe dashboard. Set to true to bring back the
# /domain page (subdomain rename + custom domain attach); that flow calls
# Dokwe's platform API, so DOKWE_API_KEY + DOKWE_PROJECT_ID become required
# (plus CLOUDFLARE_* if you provision subdomain DNS through Cloudflare).
DOMAIN_MANAGEMENT_ENABLED=false
# DOKWE_API_URL=https://dokwe.com/api
# DOKWE_API_KEY=
# DOKWE_PROJECT_ID=

###############################################################################
# Bunny Storage + CDN — DEPRECATED in favour of Dokwe (kept for rollback)
###############################################################################
# Storage zone name + zone-level API key from https://dash.bunny.net/storage.
# Region: '' / 'de' / 'ny' / 'la' / 'sg' / 'syd' / 'uk' / 'br' / 'jh'.
# Pull-zone URL is the CDN front for the storage origin.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_REGION=de
BUNNY_PULL_ZONE_URL=


MEDIA_DISK=dokwe
DOKWE_ACCESS_KEY=dkwk_xxxxxxxxxxxxxxxx
DOKWE_SECRET_KEY=<secret from Mint Key>
DOKWE_BUCKET=<your space slug>
DOKWE_ENDPOINT=https://<your space slug>-s3.dokwe.com
DOKWE_PUBLIC_URL=https://<your space slug>-file.dokwe.com
DOKWE_REGION=us-east-1