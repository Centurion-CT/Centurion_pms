{
    "$schema": "https://json.schemastore.org/web-manifest-combined",
    "name": "Keverna POS",
    "short_name": "Keverna POS",
    "description": "Point-of-sale terminal for Keverna properties — pair a phone via QR and take payments on the floor.",
    "start_url": "/dashboard/pos",
    "scope": "/dashboard/pos",
    "display": "standalone",
    "orientation": "portrait-primary",
    "background_color": "#1a1a22",
    "theme_color": "#1a1a22",
    "categories": ["business", "productivity"],
    "icons": [
        {
            "src": "/icons/pos-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/pos-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/pos-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
